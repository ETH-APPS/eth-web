# Copy to apps/api/.env. Shell/container values take precedence.
PORT=3001
NODE_ENV=development
LOG_LEVEL=info
LOG_FORMAT=pretty-json
# Enable only with LOG_LEVEL=debug or trace to include sanitized HTTP bodies.
LOG_HTTP_BODY=false
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/eth_apps"
JWT_ACCESS_SECRET="REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
