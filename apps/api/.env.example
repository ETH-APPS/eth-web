# Copy to apps/api/.env. Shell/container values take precedence.
PORT=3001
NODE_ENV=development
LOG_LEVEL=info
LOG_FORMAT=pretty-json
# Enable only with LOG_LEVEL=debug or trace to include sanitized HTTP bodies.
LOG_HTTP_BODY=false
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/eth_apps"
JWT_ACCESS_SECRET="REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
# DigitalOcean Spaces for CMS article images. Keep real keys out of Git.
SPACES_REGION=sgp1
SPACES_ENDPOINT="https://sgp1.digitaloceanspaces.com"
SPACES_BUCKET=cargoindo
SPACES_ACCESS_KEY_ID="REPLACE_WITH_SPACES_ACCESS_KEY"
SPACES_SECRET_ACCESS_KEY="REPLACE_WITH_SPACES_SECRET_KEY"
SPACES_CDN_BASE_URL="https://cargoindo.sgp1.cdn.digitaloceanspaces.com"
SPACES_ARTICLE_PREFIX="articles/development"
# Web OAuth Client ID from Google Cloud, used to verify mobile ID tokens.
# GOOGLE_WEB_CLIENT_ID="YOUR_WEB_CLIENT_ID.apps.googleusercontent.com"
