generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  STAFF
}

enum UserPermission {
  CMS_ACCESS
  CRM_ACCESS
}

enum MediaKind {
  ARTICLE_COVER
  ARTICLE_BODY
  BANNER_ILLUSTRATION
}

enum ShippingMethod {
  FCL
  LCL
  AIR
}

enum CargoRequestStatus {
  PENDING_REVIEW
  NEEDS_REVISION
  APPROVED
  REJECTED
}

enum ReviewDecision {
  APPROVED
  NEEDS_REVISION
  REJECTED
}

model User {
  id              String               @id @default(uuid()) @db.Uuid
  email           String               @unique
  firstName       String
  lastName        String?
  whatsapp        String?
  passwordHash    String?
  googleSub       String?              @unique
  role            UserRole             @default(CUSTOMER)
  cargoRequests   CargoRequest[]
  reviews         CargoRequestReview[]
  refreshSessions RefreshSession[]
  permissionGrants UserPermissionGrant[]
  authorProfile    AuthorProfile?
  mediaAssets      MediaAsset[]          @relation("MediaUploader")
  articleBanners   ArticleBanner[]       @relation("BannerCreator")
  articles         Article[]             @relation("ArticleAuthor")
  createdAt       DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(6)
}

model UserPermissionGrant {
  userId     String         @db.Uuid
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission UserPermission
  createdAt  DateTime       @default(now()) @db.Timestamptz(6)

  @@id([userId, permission])
  @@index([permission])
}

model AuthorProfile {
  userId      String   @id @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug        String   @unique
  jobTitle    String
  bio         String   @db.Text
  linkedinUrl String
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
}

model MediaAsset {
  id          String          @id @default(uuid()) @db.Uuid
  kind        MediaKind
  objectKey   String          @unique
  publicUrl   String
  mimeType    String
  sizeBytes   Int
  width       Int
  height      Int
  uploadedById String         @db.Uuid
  uploadedBy  User            @relation("MediaUploader", fields: [uploadedById], references: [id])
  articleCovers Article[]      @relation("ArticleCover")
  banner      ArticleBanner?  @relation("BannerImage")
  createdAt   DateTime        @default(now()) @db.Timestamptz(6)

  @@index([uploadedById, createdAt])
  @@index([kind, createdAt])
}

model ArticleCategory {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  normalizedName String    @unique
  slug           String    @unique
  articles       Article[]
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)

  @@index([name])
}

model ArticleTag {
  id             String                 @id @default(uuid()) @db.Uuid
  name           String
  normalizedName String                 @unique
  slug           String                 @unique
  articles       ArticleTagAssignment[]
  createdAt      DateTime               @default(now()) @db.Timestamptz(6)

  @@index([name])
}

model ArticleBanner {
  id           String       @id @default(uuid()) @db.Uuid
  title        String
  description  String       @db.Text
  imageMediaId String       @unique @db.Uuid
  image        MediaAsset   @relation("BannerImage", fields: [imageMediaId], references: [id])
  isDefault    Boolean      @default(false)
  createdById  String       @db.Uuid
  createdBy    User         @relation("BannerCreator", fields: [createdById], references: [id])
  articles     Article[]
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)

  @@index([createdAt])
}

model Article {
  id               String                 @id @default(uuid()) @db.Uuid
  slug             String                 @unique
  title            String
  metaDescription  String
  coverMediaId     String                 @db.Uuid
  coverMedia        MediaAsset             @relation("ArticleCover", fields: [coverMediaId], references: [id])
  coverImageAlt    String
  bodyHtml         String                 @db.Text
  keyPoints        String[]
  categoryId       String                 @db.Uuid
  category         ArticleCategory        @relation(fields: [categoryId], references: [id])
  bannerId         String                 @db.Uuid
  banner           ArticleBanner          @relation(fields: [bannerId], references: [id])
  authorId         String                 @db.Uuid
  author           User                   @relation("ArticleAuthor", fields: [authorId], references: [id])
  tags             ArticleTagAssignment[]
  publishedAt      DateTime               @default(now()) @db.Timestamptz(6)
  createdAt        DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime               @updatedAt @db.Timestamptz(6)

  @@index([publishedAt])
  @@index([categoryId, publishedAt])
  @@index([authorId, publishedAt])
}

model ArticleTagAssignment {
  articleId String     @db.Uuid
  article   Article    @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tagId     String     @db.Uuid
  tag       ArticleTag @relation(fields: [tagId], references: [id])

  @@id([articleId, tagId])
  @@index([tagId])
}

model CargoRequest {
  id             String               @id @default(uuid()) @db.Uuid
  customerId     String               @db.Uuid
  customer       User                 @relation(fields: [customerId], references: [id])
  status         CargoRequestStatus   @default(PENDING_REVIEW)
  shippingMethod ShippingMethod
  cargoType      String
  heightCm       Decimal              @db.Decimal(12, 2)
  lengthCm       Decimal              @db.Decimal(12, 2)
  widthCm        Decimal              @db.Decimal(12, 2)
  boxWeightKg    Decimal              @db.Decimal(12, 3)
  boxCount       Int
  notes          String?              @db.Text
  createdAt      DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @db.Timestamptz(6)
  reviews        CargoRequestReview[]

  @@index([customerId, createdAt])
  @@index([status, createdAt])
}

model CargoRequestReview {
  id             String         @id @default(uuid()) @db.Uuid
  cargoRequestId String         @db.Uuid
  cargoRequest   CargoRequest   @relation(fields: [cargoRequestId], references: [id])
  staffId        String         @db.Uuid
  staff          User           @relation(fields: [staffId], references: [id])
  decision       ReviewDecision
  reason         String?        @db.Text
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)

  @@index([cargoRequestId, createdAt])
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  @@index([userId, expiresAt])
}
