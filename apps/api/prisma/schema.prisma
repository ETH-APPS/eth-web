generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  STAFF
}

enum ShippingMethod {
  FCL
  LCL
  AIR
}

enum CargoRequestStatus {
  PENDING_REVIEW
  NEEDS_REVISION
  APPROVED
  REJECTED
}

enum ReviewDecision {
  APPROVED
  NEEDS_REVISION
  REJECTED
}

model User {
  id              String               @id @default(uuid()) @db.Uuid
  email           String               @unique
  firstName       String
  lastName        String?
  whatsapp        String?
  passwordHash    String?
  googleSub       String?              @unique
  role            UserRole             @default(CUSTOMER)
  cargoRequests   CargoRequest[]
  reviews         CargoRequestReview[]
  refreshSessions RefreshSession[]
  createdAt       DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(6)
}

model CargoRequest {
  id             String               @id @default(uuid()) @db.Uuid
  customerId     String               @db.Uuid
  customer       User                 @relation(fields: [customerId], references: [id])
  status         CargoRequestStatus   @default(PENDING_REVIEW)
  shippingMethod ShippingMethod
  cargoType      String
  heightCm       Decimal              @db.Decimal(12, 2)
  lengthCm       Decimal              @db.Decimal(12, 2)
  widthCm        Decimal              @db.Decimal(12, 2)
  boxWeightKg    Decimal              @db.Decimal(12, 3)
  boxCount       Int
  notes          String?              @db.Text
  createdAt      DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @db.Timestamptz(6)
  reviews        CargoRequestReview[]

  @@index([customerId, createdAt])
  @@index([status, createdAt])
}

model CargoRequestReview {
  id             String         @id @default(uuid()) @db.Uuid
  cargoRequestId String         @db.Uuid
  cargoRequest   CargoRequest   @relation(fields: [cargoRequestId], references: [id])
  staffId        String         @db.Uuid
  staff          User           @relation(fields: [staffId], references: [id])
  decision       ReviewDecision
  reason         String?        @db.Text
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)

  @@index([cargoRequestId, createdAt])
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  @@index([userId, expiresAt])
}
