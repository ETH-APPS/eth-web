{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["LOG_LEVEL", "LOG_FORMAT", "LOG_HTTP_BODY"]
    }
  }
}
